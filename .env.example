RECALL_API_KEY=your_recall_api_key
RECALL_BASE_URL=https://us-east-1.recall.ai/api/v1
RECALL_WEBHOOK_SECRET=whsec_your_recall_workspace_secret

PUBLIC_BASE_URL=https://your-public-host.example.com
LIVE_STREAM_GATEWAY_URL=https://your-live-stream-gateway.example.com
SERVICE_API_KEY=your_service_api_key

APP_HOST=0.0.0.0
APP_PORT=8000
BOT_NAME=Mirako Recall Bridge
RECALL_BOT_VARIANT=web_4_core
RECALL_TRANSCRIPT_ENABLED=true
RECALL_TRANSCRIPT_LANGUAGE_CODE=en
RECALL_TRANSCRIPT_MODE=prioritize_low_latency

METIS_MEMORY_BASE_URL=https://your-metis-asr.example.com
METIS_MEMORY_INSERT_PATH=/memory/insert
METIS_MEMORY_API_KEY=
METIS_MEMORY_USER=default

ZOOM_OAUTH_CLIENT_ID=your_zoom_client_id
ZOOM_OAUTH_CLIENT_SECRET=your_zoom_client_secret
ZOOM_OAUTH_ACCOUNT_ID=your_zoom_account_id
ZOOM_CREATE_USER_ID=me
ZOOM_CREATE_TOPIC=Mirako Recall Bridge
ZOOM_CREATE_DURATION_MINUTES=60
